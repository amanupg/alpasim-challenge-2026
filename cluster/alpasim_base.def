Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

# Apptainer port of the upstream alpasim-base Dockerfile (NVlabs/alpasim, e2e_challenge
# branch). Insomnia has no docker/pyxis, so the simulator services run from this SIF.
# Build from a directory holding the upstream checkout at ./alpasim:
#   apptainer build --fakeroot alpasim-base.sif alpasim_base.def

%files
    alpasim /repo

%environment
    export CC=/usr/bin/gcc-11 CXX=/usr/bin/g++-11 MAX_JOBS=4
    export PATH=/opt/cargo/bin:/usr/local/bin:$PATH
    export UV_LINK_MODE=copy UV_CACHE_DIR=/tmp/uv-cache UV_NO_SYNC=1
    export UV_PROJECT_ENVIRONMENT=/repo/.venv UV_PYTHON_INSTALL_DIR=/opt/uv-python

%post
    set -e
    export DEBIAN_FRONTEND=noninteractive
    # Insomnia gives no subuid range, so the build runs in a root-mapped namespace where
    # apt cannot drop to its _apt sandbox user; run the sandbox as (mapped) root instead.
    APT="apt-get -o APT::Sandbox::User=root"
    $APT update && $APT install -y --no-install-recommends git ffmpeg curl ca-certificates build-essential \
        gcc-11 g++-11 ninja-build libgl1 && rm -rf /var/lib/apt/lists/*
    export CC=/usr/bin/gcc-11 CXX=/usr/bin/g++-11 MAX_JOBS=4
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh
    export RUSTUP_HOME=/opt/rustup CARGO_HOME=/opt/cargo
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --no-modify-path
    export PATH=/opt/cargo/bin:$PATH UV_LINK_MODE=copy UV_CACHE_DIR=/tmp/uv-build-cache UV_PYTHON_INSTALL_DIR=/opt/uv-python
    cd /repo/src/grpc && uv sync && uv run compile-protos --no-sync
    cd /repo && uv sync --extra all --extra mtgs
    rm -rf /tmp/uv-build-cache
    chmod -R a+rX /repo /opt/cargo /opt/rustup /opt/uv-python 2>/dev/null || true
