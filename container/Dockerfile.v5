# PAI image v5 (tag is a neutral number; contents are recorded only in LEDGER.md).
# Built on top of the submitted v0.3 image so its 21 GB weights and dependency layers are reused
# (only the code layer below is new and pushed). v0.3 = Alpamayo 1.5 int8, no reasoning, 1 Hz.
#   docker buildx build --platform linux/amd64 --load -f container/Dockerfile.v5 \
#     --build-arg GIT_HASH=$(git rev-parse --short HEAD) --build-arg INTERVAL_US=<from LEDGER> -t <ecr>/teams/amanupg:v5 .
# Added since v0.3: route snap. When the plan leaves the route by >2 m and the route runs within 15 deg of the
# car's heading (lane changes and exits, not turns), drive a smooth path onto the route at the model's own
# speed. Same model call as v0.3 (one flow sample, 1 Hz), so time and memory are unchanged; the route chooser
# (6 samples) is NOT used: it added +0.005 on H100 (LEDGER 2026-10-18).
# H100, 120 PAI scenes: 0.728 vs v0.3 0.657, +0.071 [+0.011, +0.131], W/L 24/18 (LEDGER 2026-10-18).
ARG BASE=696254625193.dkr.ecr.us-east-1.amazonaws.com/teams/amanupg:v0.3-a15int8-1hz
FROM ${BASE}

USER root
RUN rm -rf /app/a15_driver
COPY src/a15_driver /app/a15_driver
RUN python -c "import a15_driver.route_choice, a15_driver.policy, a15_driver.driver; print('driver imports ok')"

ARG GIT_HASH=unknown
ARG INTERVAL_US=1000000
ENV A15_INFERENCE_INTERVAL_US=${INTERVAL_US} A15_NUM_SAMPLES=1 \
    A15_LOG_CHOICES=0 A15_NAV=0 A15_DIFF_TEMP=1.0 \
    A15_SPEED_SCALE=1.0 A15_EARLY_REPLAN=0 A15_ROUTE_SNAP=2.0 A15_ROUTE_SNAP_MAX_DEG=15 \
    A15_ROUTE_SNAP_MIN_OFFSET=0 A15_ROUTE_MEMORY=0 A15_ROUTE_PULL=0 A15_SPEED_CAMS=4 A15_GIT_HASH=${GIT_HASH}
USER alpasim
CMD ["python", "-m", "a15_driver.driver"]
